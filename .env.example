# Docker Compose identity. Do not change this without updating the reset guard.
COMPOSE_PROJECT_NAME=caldiy-qa-strategy

# Local endpoints
CALDIY_WEB_PORT=3000
CALDIY_API_PORT=5555
MAILPIT_HTTP_PORT=8025

# Local PostgreSQL fixture database
POSTGRES_USER=caldiy
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=caldiy

# Generated by scripts/bootstrap.sh on first use. Never deploy these placeholders.
NEXTAUTH_SECRET=__NEXTAUTH_SECRET__
CALENDSO_ENCRYPTION_KEY=__CALENDSO_ENCRYPTION_KEY__

# Generated API v2-only secrets. The API reuses NEXTAUTH_SECRET and
# CALENDSO_ENCRYPTION_KEY from the web service.
API_V2_JWT_SECRET=__API_V2_JWT_SECRET__
CALCOM_SERVICE_ACCOUNT_ENCRYPTION_KEY=__CALCOM_SERVICE_ACCOUNT_ENCRYPTION_KEY__

# Upstream local-development fixtures. These values are not production secrets.
CALCOM_LICENSE_KEY=00000000-0000-0000-0000-000000000000
CALDIY_API_KEY=cal_0123456789abcdef0123456789abcdef
STRIPE_API_KEY=sk_test_local_caldiy_qa_only
STRIPE_WEBHOOK_SECRET=whsec_local_caldiy_qa_only
